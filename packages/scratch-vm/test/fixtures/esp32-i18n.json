{
    "specs": {
        "esp32educonnection": {
            "name": "ESP32 Connection",
            "blocks": {
                "connect": "connect to ESP32",
                "disconnect": "disconnect from ESP32",
                "isConnected": "ESP32 connected?",
                "refresh": "refresh ESP32 status",
                "status": "ESP32 status",
                "mac": "ESP32 MAC address",
                "channel": "ESP32 Wi-Fi channel"
            },
            "card": "Add this extension first to connect to ESP32 using USB/Web Serial."
        },
        "esp32edugpio": {
            "name": "ESP32 GPIO",
            "blocks": {
                "mode": "set GPIO [PIN] mode to [MODE]",
                "write": "set GPIO [PIN] to [STATE]",
                "pwmWrite": "set PWM on GPIO [PIN] to [PERCENT] %",
                "pwmStop": "stop PWM on GPIO [PIN]",
                "read": "digital input from GPIO [PIN]"
            },
            "menus": {
                "OUTPUT": "output",
                "INPUT": "input",
                "INPUT_PULLUP": "input (pull-up)",
                "INPUT_PULLDOWN": "input (pull-down)"
            },
            "card": "Read and write digital GPIO signals."
        },
        "esp32edudht": {
            "name": "ESP32 DHT",
            "blocks": {
                "init": "initialize [TYPE] on GPIO [PIN]",
                "temp": "DHT temperature (°C)",
                "humi": "DHT humidity (%)",
                "status": "DHT status"
            },
            "card": "Read temperature and humidity from DHT11/DHT22 sensors."
        },
        "esp32eduoled": {
            "name": "ESP32 OLED",
            "blocks": {
                "init": "initialize OLED",
                "clear": "clear OLED display",
                "fillBlack": "fill OLED rectangle at X [X] Y [Y] width [W] height [H] with black",
                "cursor": "set OLED cursor to X [X] Y [Y]",
                "size": "set OLED text size to [SIZE]",
                "text": "display [TEXT] on OLED",
                "test": "test OLED display",
                "status": "OLED status",
                "ack": "last OLED response"
            },
            "card": "Display text and clear selected areas on an SSD1306 OLED."
        },
        "esp32eduespnow": {
            "name": "ESP32 ESP-NOW",
            "blocks": {
                "setChannel": "set ESP-NOW channel to [CHANNEL]",
                "channel": "ESP-NOW channel",
                "send": "send [MESSAGE] to MAC address [MAC]",
                "received": "data received via ESP-NOW",
                "hasNew": "new ESP-NOW data received?",
                "result": "ESP-NOW send result"
            },
            "card": "Send and receive text using ESP-NOW. Leave the MAC address blank to broadcast."
        },
        "esp32eduservo": {
            "name": "ESP32 Servo",
            "blocks": {
                "attach": "attach servo to GPIO [PIN]",
                "angle": "set servo angle to [ANGLE] degrees",
                "detach": "detach servo"
            },
            "card": "Control servo motors such as the SG90 using GPIO."
        },
        "esp32eduultrasonic": {
            "name": "ESP32 Ultrasonic",
            "blocks": {
                "attach": "attach ultrasonic sensor to TRIG [TRIG] ECHO [ECHO]",
                "distance": "ultrasonic sensor distance (cm)"
