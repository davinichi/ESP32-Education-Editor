            "card": "Measure distance using an HC-SR04 ultrasonic sensor."
        },
        "esp32eduenvironment": {
            "name": "ESP32 Environmental Indices",
            "blocks": {
                "index": "calculate [INDEX] from temperature [TEMP] °C and humidity [HUM] %"
            },
            "menus": {
                "DI": "Discomfort Index (DI)",
                "HEAT_INDEX": "Heat Index",
                "HUMIDEX": "Humidex",
                "DEW_POINT": "Dew Point (Td)",
                "ABS_HUM": "Absolute Humidity (AH)",
                "WET_BULB": "Wet-Bulb Temperature (Tw)",
                "VPD": "Vapor Pressure Deficit (VPD)",
                "VP": "Vapor Pressure (VP)",
                "THI": "Temperature-Humidity Index (THI)",
                "WBGT": "Estimated WBGT (simplified)"
            },
            "card": "Calculate 10 environmental indices from temperature and humidity."
        },
        "esp32edudata": {
            "name": "Data Processing",
            "blocks": {
                "splitCsv": "split CSV data [CSV]",
                "csvText": "text of CSV item [INDEX]",
